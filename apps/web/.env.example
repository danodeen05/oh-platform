CLERK_SECRET_KEY="sk_test_..."

# Interactive business plan (/plan)
PLAN_JWT_SECRET=""        # openssl rand -base64 32; signs the oh_plan session cookie
PLAN_IP_HASH_SALT=""      # openssl rand -base64 32; salts viewer IP hashes
PLAN_API_KEY=""           # shared with the API (root .env / Railway) for /plan/* BFF calls
